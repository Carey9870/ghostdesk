# path: apps/desktop/.env.example
# purpose: Build-time settings for the desktop app. Copy to .env (UI) and export the GHOSTDESK_* values before `tauri build` (Rust core).
# Public website that hosts pricing and the license API (no trailing slash).
VITE_WEB_URL=https://your-domain.example
# Read by the Rust core at compile time:
GHOSTDESK_API_BASE=https://your-domain.example
# Raw Ed25519 public key (base64) printed by `pnpm keys` in the repository root.
GHOSTDESK_LICENSE_PUBLIC_KEY=
