{
  // path: turbo.json
  // purpose: Turborepo task pipeline (build and typecheck ordering and cached outputs).
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
